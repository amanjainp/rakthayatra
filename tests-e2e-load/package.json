{
  "name": "tests-e2e-load",
  "version": "1.0.0",
  "description": "Rakthayatra — E2E browser tests (Playwright) and load/stress tests (k6)",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
