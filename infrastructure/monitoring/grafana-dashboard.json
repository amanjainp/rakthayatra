{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Application Request Rate & Error Ratio",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(lifelink_http_requests_total[5m])) by (method, route)",
          "legendFormat": "{{method}} {{route}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(lifelink_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(lifelink_http_requests_total[5m])) * 100",
          "legendFormat": "HTTP 5xx Error %",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "HTTP Latency (p95 Percentile)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(lifelink_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "95th Percentile Latency (s)",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "PostgreSQL Active Connections",
      "type": "gauge",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "lifelink_prisma_active_connections",
          "legendFormat": "Connections",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "title": "Redis Cache Hit Ratio",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(lifelink_redis_cache_hits_total[5m])) / (sum(rate(lifelink_redis_cache_hits_total[5m])) + sum(rate(lifelink_redis_cache_misses_total[5m]))) * 100",
          "legendFormat": "Cache Hit %",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "title": "RabbitMQ Queue & DLQ Depth",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "lifelink_rabbitmq_queue_depth",
          "legendFormat": "Queue: {{queue}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "lifelink_rabbitmq_dlq_size",
          "legendFormat": "DLQ: {{queue}}",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "title": "Business KPIs - Emergency Allocations",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(lifelink_business_blood_requests_created_total{urgency=\"EMERGENCY\"}[1h]))",
          "legendFormat": "Emergency Requests / hr",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(lifelink_business_donations_completed_total[1h]))",
          "legendFormat": "Donations Completed / hr",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 7,
      "title": "Node Host CPU & Memory footprint",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "lifelink_node_process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "Resident Memory (MB)",
          "range": true,
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["lifelink", "sre", "kubernetes"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "LifeLink (Rakthayatra) SRE Performance Dashboard",
  "version": 1
}
