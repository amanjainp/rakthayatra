# Port the API server listens on
PORT=5000

# Environment mode: development, staging, production, test
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/rakthayatra?schema=public"

# Log level: error, warn, info, http, debug
LOG_LEVEL=info

# CORS allowed origins (comma separated)
ALLOWED_ORIGINS="http://localhost:3000"

# JWT secret key for access tokens
JWT_SECRET="supersecretaccesskey"

# Comma-separated list of hex-encoded 32-byte encryption keys for AES field encryption
ENCRYPTION_KEYS="dev-key-must-be-32-characters-long-!"

# AWS S3 Avatar & Document Storage parameters
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="lifelink-storage-bucket"

# Google Maps API Key for Geocoding & Radius calculation
GOOGLE_MAPS_API_KEY=""

# Firebase Admin Service credentials for Push Notifications
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Infrastructure Cache & Message Broker connection URLs
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://localhost:5672"

# PostgreSQL Read Replica URL (optional — leave blank in development)
DATABASE_URL_REPLICA=""

# SMTP Email Provider Credentials (leave blank in development to use mock provider)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@lifelink.org"

# Twilio SMS Provider Credentials (leave blank in development to use mock provider)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Sentry Error Monitoring DSN (leave blank to disable Sentry in development)
SENTRY_DSN=""

