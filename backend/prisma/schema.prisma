datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum BloodComponent {
  WHOLE_BLOOD
  PACKED_RBC
  PLASMA
  PLATELETS
  CRYOPRECIPITATE
}

enum RequestUrgency {
  NORMAL
  EMERGENCY
}

enum RequestStatus {
  PENDING
  APPROVED
  FULFILLED
  CANCELLED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  EXPIRED
  DISTRIBUTED
}

enum DonationStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  EMERGENCY_ALERT
  REQUEST_UPDATE
  DONATION_REMINDER
  LOW_INVENTORY
  REDISTRIBUTION_ALERT
}

enum CampStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RedistributionUrgency {
  ROUTINE
  URGENT
  CRITICAL
}

enum RedistributionStatus {
  REQUESTED
  MATCHING
  PROPOSED
  AWAITING_APPROVAL
  APPROVED
  RESERVED
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  FAILED
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  permissions String[]
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  roleId           String
  role             Role              @relation(fields: [roleId], references: [id])
  status           UserStatus        @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  donorProfile     DonorProfile?
  hospitalProfile  HospitalProfile?
  bloodBankProfile BloodBankProfile?
  
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  bloodRequests           BloodRequest[]           @relation("UserRequests")
  deviceTokens            DeviceToken[]
  userConsent             UserConsent?
  redistributionRequests  RedistributionRequest[]  @relation("UserRedistributionRequests")
  redistributionProposals RedistributionProposal[] @relation("UserRedistributionProposals")
  redistributionEvents    RedistributionEvent[]    @relation("UserRedistributionEvents")

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model DonorProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  gender                String
  dob                   DateTime
  phone                 String              @unique
  bloodGroup            BloodGroup
  address               String
  latitude              Float
  longitude             Float
  lastDonationDate      DateTime?
  isAvailable           Boolean             @default(true)
  consentGiven          Boolean             @default(false)
  consentDate           DateTime?
  requestsNotifiedCount Int                 @default(0)
  requestsAcceptedCount Int                 @default(0)
  deletedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  eligibility           MedicalEligibility?
  donations             Donation[]
  appointments          Appointment[]
  donationCampId        String?
  donationCamp          DonationCamp?       @relation(fields: [donationCampId], references: [id], onDelete: SetNull)

  @@index([latitude, longitude])
  @@index([bloodGroup, isAvailable])
}

model MedicalEligibility {
  id                String       @id @default(uuid())
  donorProfileId    String       @unique
  donor             DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)
  answers           Json
  isEligible        Boolean      @default(true)
  nextEligibleDate  DateTime?
  migrationStatus   String       @default("SUCCESS") // "SUCCESS", "FAILED", "PENDING"
  migrationError    String?
  migrationAttempts Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model HospitalProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  licenseNumber String    @unique
  phone         String
  address       String
  city          String
  latitude      Float
  longitude     Float
  isVerified    Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  appointments                   Appointment[]
  inventory                      BloodInventory[]
  incomingRedistributionRequests RedistributionRequest[]  @relation("DestHospitalRedistRequests")
  outgoingProposals              RedistributionProposal[] @relation("SourceHospitalProposals")
  sourceTransfers                RedistributionTransfer[] @relation("SourceHospitalTransfers")
  destinationTransfers           RedistributionTransfer[] @relation("DestHospitalTransfers")

  @@index([latitude, longitude])
}

model BloodBankProfile {
  id            String           @id @default(uuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  licenseNumber String           @unique
  phone         String
  address       String
  city          String
  latitude      Float
  longitude     Float
  isVerified    Boolean          @default(false)
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  inventory                      BloodInventory[]
  donations                      Donation[]
  appointments                   Appointment[]
  targetedRequests               BloodRequest[]           @relation("TargetedBloodBank")
  allocatedRequests              BloodRequest[]           @relation("AllocatedBloodBank")
  incomingRedistributionRequests RedistributionRequest[]  @relation("DestBankRedistRequests")
  outgoingProposals              RedistributionProposal[] @relation("SourceBankProposals")
  sourceTransfers                RedistributionTransfer[] @relation("SourceBankTransfers")
  destinationTransfers           RedistributionTransfer[] @relation("DestBankTransfers")

  @@index([latitude, longitude])
}

model BloodInventory {
  id             String                     @id @default(uuid())
  bloodBankId    String?
  bloodBank      BloodBankProfile?          @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
  hospitalId     String?
  hospital       HospitalProfile?           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bloodGroup     BloodGroup
  componentType  BloodComponent             @default(WHOLE_BLOOD)
  unitsCount     Int
  expiryDate     DateTime
  collectionDate DateTime?
  batchNumber    String?
  storageTemp    String?
  status         InventoryStatus            @default(AVAILABLE)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  allocations    RedistributionAllocation[]

  @@index([bloodBankId])
  @@index([hospitalId])
  @@index([bloodGroup, status])
  @@index([bloodGroup, componentType, status])
}

model BloodRequest {
  id                   String            @id @default(uuid())
  requesterId          String
  requester            User              @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  bloodGroup           BloodGroup
  unitsRequired        Int
  urgency              RequestUrgency    @default(NORMAL)
  status               RequestStatus     @default(PENDING)
  locationName         String
  latitude             Float
  longitude            Float
  message              String?
  targetBloodBankId    String?
  targetBloodBank      BloodBankProfile? @relation("TargetedBloodBank", fields: [targetBloodBankId], references: [id], onDelete: SetNull)
  allocatedBloodBankId String?
  allocatedBloodBank   BloodBankProfile? @relation("AllocatedBloodBank", fields: [allocatedBloodBankId], references: [id], onDelete: SetNull)
  allocatedUnits       Int               @default(0)
  responseNotes        String?
  radiusKm             Float?            @default(100)
  acceptedDonorIds     String[]          @default([])
  expiresAt            DateTime
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([latitude, longitude])
  @@index([bloodGroup, status])
  @@index([targetBloodBankId])
  @@index([allocatedBloodBankId])
}

model Donation {
  id             String            @id @default(uuid())
  donorProfileId String
  donor          DonorProfile      @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)
  bloodBankId    String?
  bloodBank      BloodBankProfile? @relation(fields: [bloodBankId], references: [id], onDelete: SetNull)
  donationCampId String?
  donationCamp   DonationCamp?     @relation(fields: [donationCampId], references: [id], onDelete: SetNull)
  donationDate   DateTime          @default(now())
  unitsDonated   Int
  status         DonationStatus    @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([donorProfileId])
  @@index([bloodBankId])
  @@index([donationCampId])
}

model DonationCamp {
  id                      String         @id @default(uuid())
  name                    String
  organizer               String
  address                 String
  city                    String
  latitude                Float
  longitude               Float
  startDate               DateTime
  endDate                 DateTime
  status                  CampStatus     @default(UPCOMING)
  externalRegistrationUrl String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  deletedAt               DateTime?
  
  donors    DonorProfile[]
  donations Donation[]

  @@index([latitude, longitude])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserConsent {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentGiven          Boolean  @default(false)
  consentTimestamp      DateTime @default(now())
  consentVersion        String
  privacyPolicyVersion  String
  termsVersion          String
  ipAddress             String?
  registrationTimestamp DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model NotificationAudit {
  id            String   @id @default(uuid())
  type          String   // "EMAIL", "SMS", "PUSH"
  recipient     String
  subject       String?
  body          String
  status        String   // "PENDING", "DELIVERED", "FAILED", "DLQ"
  provider      String?  // "SMTP", "TWILIO", "FIREBASE", "MOCK"
  failureReason String?
  attempts      Int      @default(0)
  eventId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId])
  @@index([status])
}

model Appointment {
  id              String            @id @default(uuid())
  donorProfileId  String
  donor           DonorProfile      @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)
  facilityType    String            // "HOSPITAL" or "BLOOD_BANK"
  hospitalId      String?
  hospital        HospitalProfile?  @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  bloodBankId     String?
  bloodBank       BloodBankProfile? @relation(fields: [bloodBankId], references: [id], onDelete: SetNull)
  appointmentDate DateTime
  timeSlot        String            // e.g. "09:00 AM - 11:00 AM"
  status          String            @default("SCHEDULED") // "SCHEDULED", "COMPLETED", "CANCELLED"
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([donorProfileId])
  @@index([hospitalId])
  @@index([bloodBankId])
  @@index([appointmentDate, status])
}

model RedistributionRequest {
  id                        String                   @id @default(uuid())
  requesterUserId           String
  requester                 User                     @relation("UserRedistributionRequests", fields: [requesterUserId], references: [id], onDelete: Cascade)
  destinationFacilityType   String                   // "HOSPITAL" or "BLOOD_BANK"
  destinationHospitalId     String?
  destinationHospital       HospitalProfile?         @relation("DestHospitalRedistRequests", fields: [destinationHospitalId], references: [id], onDelete: SetNull)
  destinationBloodBankId    String?
  destinationBloodBank      BloodBankProfile?        @relation("DestBankRedistRequests", fields: [destinationBloodBankId], references: [id], onDelete: SetNull)
  bloodGroup                BloodGroup
  componentType             BloodComponent           @default(WHOLE_BLOOD)
  unitsRequired             Int
  urgency                   RedistributionUrgency    @default(ROUTINE)
  status                    RedistributionStatus     @default(REQUESTED)
  requiredBy                DateTime
  minRemainingShelfLifeDays Int                      @default(3)
  deliveryAddress           String
  deliveryLatitude          Float
  deliveryLongitude         Float
  reason                    String
  specialHandlingNotes      String?
  additionalNotes           String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  proposals                 RedistributionProposal[]
  transfers                 RedistributionTransfer[]
  events                    RedistributionEvent[]

  @@index([status])
  @@index([bloodGroup, componentType, status])
  @@index([destinationHospitalId])
  @@index([destinationBloodBankId])
  @@index([createdAt])
}

model RedistributionProposal {
  id                  String                  @id @default(uuid())
  requestId           String
  request             RedistributionRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposerUserId      String
  proposer            User                    @relation("UserRedistributionProposals", fields: [proposerUserId], references: [id], onDelete: Cascade)
  sourceFacilityType  String                  // "HOSPITAL" or "BLOOD_BANK"
  sourceHospitalId    String?
  sourceHospital      HospitalProfile?        @relation("SourceHospitalProposals", fields: [sourceHospitalId], references: [id], onDelete: SetNull)
  sourceBloodBankId   String?
  sourceBloodBank     BloodBankProfile?       @relation("SourceBankProposals", fields: [sourceBloodBankId], references: [id], onDelete: SetNull)
  bloodGroup          BloodGroup
  componentType       BloodComponent
  unitsProposed       Int
  status              ProposalStatus          @default(PENDING)
  proposedInventoryIds String[]               @default([])
  estimatedDistanceKm Float?
  estimatedTransitMins Int?
  notes               String?
  rejectionReason     String?
  reviewedByUserId    String?
  reviewedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  transfer            RedistributionTransfer?

  @@index([requestId])
  @@index([sourceHospitalId])
  @@index([sourceBloodBankId])
  @@index([status])
}

model RedistributionTransfer {
  id                        String                     @id @default(uuid())
  requestId                 String
  request                   RedistributionRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposalId                String                     @unique
  proposal                  RedistributionProposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  sourceFacilityType        String                     // "HOSPITAL" or "BLOOD_BANK"
  sourceHospitalId          String?
  sourceHospital            HospitalProfile?           @relation("SourceHospitalTransfers", fields: [sourceHospitalId], references: [id], onDelete: SetNull)
  sourceBloodBankId         String?
  sourceBloodBank           BloodBankProfile?          @relation("SourceBankTransfers", fields: [sourceBloodBankId], references: [id], onDelete: SetNull)
  destinationFacilityType   String                     // "HOSPITAL" or "BLOOD_BANK"
  destinationHospitalId     String?
  destinationHospital       HospitalProfile?           @relation("DestHospitalTransfers", fields: [destinationHospitalId], references: [id], onDelete: SetNull)
  destinationBloodBankId    String?
  destinationBloodBank      BloodBankProfile?          @relation("DestBankTransfers", fields: [destinationBloodBankId], references: [id], onDelete: SetNull)
  bloodGroup                BloodGroup
  componentType             BloodComponent
  unitsApproved             Int
  unitsDispatched           Int?
  unitsReceived             Int?
  status                    RedistributionStatus       @default(RESERVED)
  shipmentReference         String?                    @unique
  dispatcherName            String?
  dispatchedByUserId        String?
  dispatchedAt              DateTime?
  transportVehicleDetails   String?
  temperatureCheckConfirmed Boolean                    @default(false)
  coldChainNotes            String?
  expectedArrivalAt         DateTime?
  inTransitUpdatedAt        DateTime?
  inTransitNotes            String?
  receivedByUserId          String?
  receiverStaffName         String?
  receivedAt                DateTime?
  conditionVerified         Boolean                    @default(false)
  hasDiscrepancy            Boolean                    @default(false)
  discrepancyReason         String?
  damagedUnits              Int                        @default(0)
  completedAt               DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?
  idempotencyKey            String?                    @unique
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  allocations               RedistributionAllocation[]
  events                    RedistributionEvent[]

  @@index([requestId])
  @@index([sourceHospitalId])
  @@index([sourceBloodBankId])
  @@index([destinationHospitalId])
  @@index([destinationBloodBankId])
  @@index([status])
}

model RedistributionAllocation {
  id                  String                 @id @default(uuid())
  transferId          String
  transfer            RedistributionTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryId         String
  inventory           BloodInventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  originalInventoryId String?
  bloodGroup          BloodGroup
  componentType       BloodComponent
  unitsAllocated      Int
  expiryDate          DateTime
  status              String                 @default("RESERVED") // "RESERVED", "DISPATCHED", "RECEIVED", "RELEASED"
  reservedByUserId    String
  reservedAt          DateTime               @default(now())
  releasedAt          DateTime?

  @@index([transferId])
  @@index([inventoryId])
}

model RedistributionEvent {
  id                   String                  @id @default(uuid())
  requestId            String?
  request              RedistributionRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  transferId           String?
  transfer             RedistributionTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  actorUserId          String?
  actor                User?                   @relation("UserRedistributionEvents", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole            String?
  actorInstitutionId   String?
  actorInstitutionName String?
  action               String
  previousState        String?
  newState             String?
  reason               String?
  metadata             Json?
  correlationId        String?
  createdAt            DateTime                @default(now())

  @@index([requestId])
  @@index([transferId])
  @@index([actorUserId])
  @@index([createdAt])
}
