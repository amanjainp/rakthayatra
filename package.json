{
  "name": "rakthayatra",
  "version": "1.0.0",
  "description": "Production-grade blood donation logistics platform - LifeLink",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "tests-e2e-load"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:seed": "npm run prisma:seed --workspace=backend",
    "render:build:backend": "npm run render-build --workspace=backend",
    "test:backend": "npm run test --workspace=backend",
    "test:e2e": "npm run test:e2e --workspace=tests-e2e-load",
    "test:load": "npm run test:load --workspace=tests-e2e-load",
    "test:stress": "npm run test:stress --workspace=tests-e2e-load",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.2"
  }
}
